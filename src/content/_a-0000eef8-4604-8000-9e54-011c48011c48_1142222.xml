        <definition>a!localVariables(
  local!applications: if(
    and(
      a!isNotNullOrEmpty(ri!orgid),
      a!isNotNullOrEmpty(ri!applicationid)
    ),
    #"_a-0000eef8-4604-8000-9e54-011c48011c48_1142076"(
      applicationid: ri!applicationid,
      isActive: true(),
      orgId: ri!orgid
    ),
    null()
  ),

  if(
    a!isNotNullOrEmpty(local!applications),
    #"SYSTEM_SYSRULES_forEach"(
      items: local!applications,
      expression: #"urn:appian:function:v1:a:update"(
