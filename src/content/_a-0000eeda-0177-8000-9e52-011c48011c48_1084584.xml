    <rule>
        <name>UAM_qry_getOrganizationNames</name>
        <uuid>_a-0000eeda-0177-8000-9e52-011c48011c48_1084584</uuid>
        <description>To query the organization names. Here filter for sub organization is also listed here
</description>
        <parentUuid>d697af9a-04b4-44be-a290-57a27daea979</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!names: if(
    or(
      a!isNotNullOrEmpty(ri!orgId),
      a!isNotNullOrEmpty(ri!Isparentorg),
      a!isNotNullOrEmpty(ri!excludeorgid),
      a!isNotNullOrEmpty(ri!isActive)
    ),
    #"SYSTEM_SYSRULES_queryRecordType_v3"(
      recordType: #"urn:appian:record-type:v1:008dc9c2-5821-421b-b1dd-e322b8e6665f",
      fields: #"SYSTEM_SYSRULES_selectionFields"(
        allFieldsFromRecordType: #"urn:appian:record-type:v1:008dc9c2-5821-421b-b1dd-e322b8e6665f"
      ),
      filters: #"SYSTEM_SYSRULES_queryLogicalExpression"(
        operator: "AND",
        filters: {
          #"SYSTEM_SYSRULES_queryFilter"(
            field: #"urn:appian:record-field:v1:008dc9c2-5821-421b-b1dd-e322b8e6665f/5793af42-009b-4cef-b5b5-7c4a81f902ec",
            /* To the organization ID*/
            operator: "in",
            value: ri!orgId
          ),
          #"SYSTEM_SYSRULES_queryFilter"(
            field: #"urn:appian:record-field:v1:008dc9c2-5821-421b-b1dd-e322b8e6665f/5793af42-009b-4cef-b5b5-7c4a81f902ec",
            /* This query rule is called selected sub organization interface when the org id is 1 other than that remaining id will be displayed*/
            operator: "not in",
            value: ri!excludeorgid
          ),
          #"SYSTEM_SYSRULES_queryFilter"(
            field: #"urn:appian:record-field:v1:008dc9c2-5821-421b-b1dd-e322b8e6665f/56279cd7-e7c5-4577-9c40-eae4b315ac12",
            operator: "=",
            value: ri!Isparentorg
          ),
          #"SYSTEM_SYSRULES_queryFilter"(
            field: #"urn:appian:record-field:v1:008dc9c2-5821-421b-b1dd-e322b8e6665f/b0ac5bbd-9773-410d-9da1-e2a26bea4a13",
            operator: "=",
            value: ri!isActive
          )
        },
        ignoreFiltersWithEmptyValues: true(),
        
      ),
      pagingInfo: a!defaultValue(
        value: ri!paginginfo,
        default: #"SYSTEM_SYSRULES_pagingInfo"(startIndex: 1, batchSize: 5000)
      )
    ),
    {}
  ),
  local!data: index(local!names, "data", null()),
  local!data
)</definition>
