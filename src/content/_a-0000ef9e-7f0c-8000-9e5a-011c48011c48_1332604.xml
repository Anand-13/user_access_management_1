    #"_a-0000ef67-4afa-8000-9e56-011c48011c48_1223271"(
      orgid: ri!orgid,
      teamid: ri!teamid,
      user: ri!user,
      isActive: true()
    ),
    null()
  ),

  if(
    a!isNotNullOrEmpty(local!removeorganizations),
    #"SYSTEM_SYSRULES_forEach"(
      items: local!removeorganizations,
      expression: #"urn:appian:function:v1:a:update"(
