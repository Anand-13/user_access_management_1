        <name>UAM_getTeamManager</name>
        <uuid>_a-0000eef8-4604-8000-9e54-011c48011c48_1088723</uuid>
        <description>To get the Team Manager
</description>
        <parentUuid>d697af9a-04b4-44be-a290-57a27daea979</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  /* Step 1: Get raw data */
  local!data: if(
    a!isNotNullOrEmpty(ri!orgid),
    #"_a-0000eef8-4604-8000-9e54-011c48011c48_1134349"(orgid: ri!orgid, isActive: true()),
    {}
  ),

  /* Step 2: Get org ID */
  local!orgId: if(
    a!isNotNullOrEmpty(local!data),
    index(
      local!data,
      #"urn:appian:record-field:v1:4eb1fdb2-adfe-4b4b-8a61-ccc9f1f5f947/96d37d06-45e7-4282-8de1-85e282e0ef8b",
      {}
    ),
    {}
  ),

  /* Step 3: Get org details */
  local!orgdetails: if(
    a!isNotNullOrEmpty(local!orgId),
    #"_a-0000eef8-4604-8000-9e54-011c48011c48_1123673"(orgId: local!orgId),
    {}
  ),

  /* Step 4: Get project manager */
  local!projectManager: if(
    a!isNotNullOrEmpty(local!orgdetails),
    index(
      local!orgdetails,
      #"urn:appian:record-field:v1:008dc9c2-5821-421b-b1dd-e322b8e6665f/4b67e544-964e-485d-90df-3947cc4b80b2",
      null()
    ),
    null()
  ),

  local!projectManager
)</definition>
