        <definition>a!localVariables(
  local!teamGroups: #"_a-0000efc0-69e9-8000-9e5b-011c48011c48_1342328"(
    orgid: ri!orgid,
    teamid: ri!teamid
  ),
  local!groups: a!refreshVariable(value: #"SYSTEM_SYSRULES_forEach"(
    items: local!teamGroups,
    expression: #"urn:appian:function:v1:a:isusermemberofgroup?okey=a!isUserMemberOfGroup"(loggedInUser(), togroup(fv!item))
  ),refreshOnVarChange: ri!time),
  and(
    a!isNotNullOrEmpty(local!teamGroups),
    not(contains(local!groups,
      false
    ))
  ),
)</definition>
