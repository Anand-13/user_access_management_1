        <uuid>_a-0000ef67-4afa-8000-9e56-011c48011c48_1245723</uuid>
        <description>Expression to demap team with the application roles
</description>
        <parentUuid>d697af9a-04b4-44be-a290-57a27daea979</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!removeteamapplications:if(
    or(
      a!isNotNullOrEmpty(ri!teamid),
      a!isNotNullOrEmpty(ri!selectedgroupids)
    ),
    #"_a-0000eef8-4604-8000-9e54-011c48011c48_1138645"(teamid: ri!teamid,
    groupid: ri!selectedgroupids),
    null()
  ),
 if(a!isNotNullOrEmpty(local!removeteamapplications),
 #"SYSTEM_SYSRULES_forEach"(
   items: local!removeteamapplications,
   expression: #"urn:appian:function:v1:a:update"(
     fv!item,
     #"urn:appian:record-field:v1:139cb21e-dd78-4694-a8ad-b43e2d51226f/588ea49d-583b-48a8-8a84-19913aa10420",
     false()
   )
 ),
 null()
 )
)

</definition>
