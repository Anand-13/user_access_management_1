    <interface>
        <name>UAM_togglefield_toCheckActiveOrInactive</name>
        <uuid>_a-0000ef9e-7f0c-8000-9e5a-011c48011c48_1326124</uuid>
        <description>To check whether the user is active or inactive</description>
        <parentUuid>d697af9a-04b4-44be-a290-57a27daea979</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!showInactive: false,
  {
    #"SYSTEM_SYSRULES_toggleField"(
      choiceLabel: "Show Inactive Users",
      value: local!showInactive,
      saveInto: local!showInactive
    ),

    #"SYSTEM_SYSRULES_richTextDisplayField"(
      labelPosition: "COLLAPSED",
      value: #"SYSTEM_SYSRULES_richTextItem_v1"(
        text: if(
          local!showInactive,
          "Toggle is ON — showing inactive users",
          "Toggle is OFF — showing active users"
        ),
        style: "STRONG",
        color: if(local!showInactive, "ACCENT", "SECONDARY")
      )
    )
  }
)</definition>
        <preferredEditor>interface</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
        <isCustom>false</isCustom>
    </interface>
